# ==============================================================================
# GALAXY HERITAGE WORLD — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# 1. Application Environment
NODE_ENV=development
APP_VERSION=1.0.0

# 2. Frontend & Backend URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# 3. MySQL 8 Database (Prisma ORM)
DATABASE_URL="mysql://root:@127.0.0.1:3307/galaxy_heritage_world"

# 4. Authentication & Security (JWT & Cookies)
JWT_ACCESS_SECRET="replace-with-strong-64-char-access-secret-in-production"
JWT_REFRESH_SECRET="replace-with-strong-64-char-refresh-secret-in-production"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_SECRET="replace-with-strong-cookie-secret-in-production"

# 5. Initial Seed Admin Account (Development / Setup Only)
SEED_ADMIN_EMAIL="admin@galaxyheritageworld.com"
SEED_ADMIN_PASSWORD="ChangeMeImmediately!2026"
SEED_ADMIN_NAME="GHW Super Admin"

# 6. SMTP / Transactional Email (Nodemailer)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="notifications@galaxyheritageworld.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM_EMAIL="info@galaxyheritageworld.com"
SALES_NOTIFICATION_EMAIL="info@galaxyheritageworld.com"

# 7. Optional Redis & Background Jobs (BullMQ)
REDIS_ENABLED=false
REDIS_URL="redis://localhost:6379"

# 8. Optional Media Storage (Local / S3 / Cloudinary)
STORAGE_PROVIDER="local"
UPLOAD_MAX_SIZE_BYTES=10485760
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# 9. Payment Gateway Link / Razorpay (Optional)
NEXT_PUBLIC_PAYMENT_PORTAL_URL="https://payments.cashfree.com/forms/ghwhospitality"
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
